{
  "name": "homeschool",
  "version": "0.1.5",
  "description": "Homeschool management desktop application",
  "type": "module",
  "main": "./out/main/index.js",
  "author": {
    "name": "Scott Scoble",
    "email": "scott@scoble.me"
  },
  "scripts": {
    "tokens:build": "style-dictionary build",
    "predev": "npm run tokens:build",
    "dev": "electron-vite dev",
    "dev:ws": "HOMESCHOOL_USE_WEBSOCKET=1 electron-vite dev",
    "prebuild": "npm run tokens:build",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:renderer",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile": "cd mobile && npm start",
    "mobile:ios": "cd mobile && npm run ios",
    "mobile:android": "cd mobile && npm run android",
    "mobile:install": "cd mobile && npm install",
    "mobile:build:ios": "cd mobile && npm run build:ios",
    "mobile:build:android": "cd mobile && npm run build:android",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@headlessui/react": "^2.2.4",
    "@roamhq/wrtc": "^0.9.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/ws": "^8.18.1",
    "b4a": "^1.7.3",
    "bonjour-service": "^1.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "eventsource": "^4.1.0",
    "googleapis": "^169.0.0",
    "hypercore": "^11.21.6",
    "hyperswarm": "^4.16.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "smee-client": "^5.0.0",
    "sodium-universal": "^5.0.1",
    "sql.js": "^1.13.0",
    "uuid": "^11.1.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@storybook/test-runner": "^0.24.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.19.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.21",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest-image-snapshot": "^6.5.1",
    "jscodeshift": "^17.3.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.57.0",
    "postcss": "^8.5.4",
    "storybook": "^10.1.11",
    "style-dictionary": "^5.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.3.5",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "src/renderer/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "mobile/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
